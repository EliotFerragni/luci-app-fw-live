config fw_live 'main'
	# Master switch for the capture service.
	option enabled '1'
	# Capture accepted connections from the conntrack event stream.
	option accepts '1'
	# Capture denied packets from the firewall's kernel log. Nothing appears
	# here until a zone has option log '1'; this package never edits
	# /etc/config/firewall itself.
	option denies '1'
	# Events kept per source. Everything is in RAM and nothing survives a
	# reboot: this is a live view, not a history.
	option buffer_size '5000'
	# Events per second accepted per source before the excess is shed. A
	# misconfigured log rule on a busy router must not be able to wedge it.
	option max_rate '200'
	# How often the view asks for new events, in seconds.
	option poll_interval '2'
	# Drop events where both endpoints are on a local network, which is most
	# of the router talking to itself.
	option ignore_local '0'
	# What counts as local, which decides the direction column and what
	# ignore_local leaves out. Every address the router holds is found on its
	# own, so both of these are usually unset.
	#
	# Name uci network interfaces to count only those; with none named every
	# interface counts, which is right on most routers.
	#	list local_network 'lan'
	#	list local_network 'guest'
	#
	# Prefixes no interface announces. A tunnel gives the router one address
	# on the link while the site on the far side is a route, so a VPN subnet
	# is invisible to netifd and its traffic reads as foreign until it is
	# named here.
	#	list local_subnet '192.168.50.0/24'
	#	list local_subnet 'fd00:abc::/48'
	# One packet is often logged twice: once by the rule it matched, whose
	# prefix is only a name (Block-Internet), and once by the chain that
	# refused it, whose prefix carries the verdict and no name (reject wan
	# out). Fold those into one row with both. Rules that each log the same
	# packet become the path it took, Block-Internet > Block-DNS2.
	option merge_rules '1'
	# Drop log events that are still unknown after the above, which is a rule
	# logged through option log whose packet no other line accounted for. What
	# it costs: an allowed connection is only recognised later, when the log
	# event meets its conntrack event, so dropping it here leaves accepted
	# traffic with an empty rule column. Worth turning on for a rule that logs
	# far more than it decides, a MARK rule for policy routing say.
	option ignore_unknown '0'
	# Display only. auto follows the browser's locale; 24 or 12 force the
	# clock, dmy prints 31/12 and mdy prints 12/31.
	option time_format 'auto'
	option date_format 'auto'
