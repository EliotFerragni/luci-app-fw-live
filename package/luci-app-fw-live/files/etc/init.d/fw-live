#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/fwlive-follow

start_service() {
	config_load fw-live
	config_get ENABLED main enabled 1
	[ "$ENABLED" = "1" ] || return 0

	# The follower reads this at startup and on every trim, so the direction
	# column is right from the first event.
	/usr/bin/fwlive-subnets >/dev/null 2>&1

	procd_open_instance
	procd_set_param command "$PROG"
	# procd hashes this and restarts the instance by itself when it changes.
	# Without it the instance definition is identical from one start to the
	# next, procd sees nothing to do, and a settings change has no effect
	# until something restarts the service by hand.
	procd_set_param file /etc/config/fw-live
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/fw-live.pid
	procd_close_instance
}

# Not stop_service: rc.common runs that one *before* procd_kill, so anything
# deleted there is deleted while the follower is still running and about to be
# asked to stop. It reads its pid files during that shutdown to find its reader,
# its ticker and its parser, and it writes into its fifos until the moment they
# go, so removing either from under it orphans the whole feed. That is what left
# a logread, a conntrack and two awk behind on every single upgrade.
#
# service_stopped runs after procd_kill instead. Even here nothing the follower
# owns is touched: it removes its own pid files and fifos as it goes, and if it
# was killed outright rather than asked, what it left is exactly what the next
# instance sweeps. Only the spools are cleared, so a stopped service does not
# leave a frozen buffer that still looks live on the page.
service_stopped() {
	rm -f /tmp/fw-live/events.log /tmp/fw-live/events.ct \
	      /tmp/fw-live/events.log.new /tmp/fw-live/events.ct.new \
	      /tmp/fw-live/stats.log /tmp/fw-live/stats.ct
}

service_triggers() {
	procd_add_reload_trigger "fw-live" "network"
}

reload_service() {
	# A network change moves the local prefixes the direction column is
	# derived from, so they are refreshed either way.
	/usr/bin/fwlive-subnets >/dev/null 2>&1

	# Then just hand procd the service definition again and let it decide.
	# It restarts the instance when the config file it is watching has
	# changed, and leaves it alone when nothing did, which is both cheaper
	# and safer than stopping and starting by hand: there is no window in
	# which the old instance has been asked to go but the new one is already
	# being registered.
	start
}

status_service() {
	/usr/bin/fwlive-status
}
