#!/bin/sh
# Filter the live buffer and print the newest matching events as JSON.
#
#   fwlive-query <limit> <after_log> <after_ct> <verdict> <proto> <dir> <search>
#
# after_log and after_ct are the per source high water sequence numbers the
# view already holds, so a 2 second poll asks for the handful of events it has
# not seen rather than the whole page again. Zero on either means "the most
# recent limit events from that source".
#
# verdict is a comma separated subset of accept, drop, reject and unknown;
# unknown being a packet logged by a rule whose prefix carries only a name,
# which says nothing about what became of it. proto and dir are single values.
# An empty value means no filtering on that field.
#
# search is a small query language over the addresses, the ports, the
# interfaces, the rule and the flags, all matched as case insensitive
# substrings:
#
#   a b          both have to match
#   -a           this one must not
#   a,b          either of them counts as a match
#   "two words"  one term that contains a space, which every fw4 zone prefix
#                and a merged rule path both do
#
# counts are over the whole buffer rather than the returned page, so the
# summary line stays meaningful while a filter is active.
#
# A denied event whose prefix named a rule but no verdict is resolved against
# the accepted feed before any of that: a matching conntrack event means the
# packet was allowed through, so it is reported as accepted rather than as
# unknown.
#
# The work is in awk on purpose: ucode is far slower over this many lines, so
# the rpcd backend stays thin.

RUN=${FWLIVE_RUN:-/tmp/fw-live}

LIMIT=${1:-200}
AFTER_LOG=${2:-0}
AFTER_CT=${3:-0}
VERDICT=$(printf '%s' "${4:-}" | sed 's/[^a-z,]//g')
PROTO=$(printf '%s' "${5:-}" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9]//g')
DIR=$(printf '%s' "${6:-}" | sed 's/[^a-z]//g')
# Only ever handed to awk through -v, never onto a shell command line, but
# keep it to what an address, a port or a rule name can hold. The three
# characters added for the query language are the quote, the comma and the >,
# the last of them because a merged row's rule column is a path, A > B, and
# clicking it has to be able to ask for that exact string. The minus was
# already in the set, since a rule name is full of them.
SEARCH=$(printf '%s' "${7:-}" | sed 's![^0-9A-Za-z.:_/ ",>-]!!g' | cut -c1-160)

case "$LIMIT" in ''|*[!0-9]*) LIMIT=200 ;; esac
case "$AFTER_LOG" in ''|*[!0-9]*) AFTER_LOG=0 ;; esac
case "$AFTER_CT" in ''|*[!0-9]*) AFTER_CT=0 ;; esac
[ "$LIMIT" -lt 1 ] && LIMIT=200
[ "$LIMIT" -gt 1000 ] && LIMIT=1000

NOW=$(date +%s)

# The accepted feed is read first on purpose: a denied event whose prefix
# carried no verdict is resolved against it, and that needs the conntrack
# tuples already in hand by the time the log events are read.
FILES=""
[ -f "$RUN/events.ct" ] && FILES="$FILES $RUN/events.ct"
[ -f "$RUN/events.log" ] && FILES="$FILES $RUN/events.log"

awk -F'\t' -v now="$NOW" -v lim="$LIMIT" -v alog="$AFTER_LOG" -v act="$AFTER_CT" \
    -v vfilter="$VERDICT" -v pfilter="$PROTO" -v dfilter="$DIR" -v q="$SEARCH" \
    -v statlog="$RUN/stats.log" -v statct="$RUN/stats.ct" '
function statval(f, k,   l, n, v) {
	v = 0
	while ((getline l < f) > 0) {
		n = split(l, _st, " ")
		if (n >= 2 && _st[1] == k) v = _st[2] + 0
	}
	close(f)
	return v
}

# The search box is a small query language, parsed once in BEGIN. A term is a
# run of characters between spaces; quotes hold a space inside one term, which
# a fw4 zone prefix and a merged rule path both need; a minus in front of a
# term excludes; and commas inside a term make it any-of.
function add_term(t, neg,   bare) {
	bare = t
	gsub(/,/, "", bare)
	if (bare == "") return
	if (neg) { nneg++; negterm[nneg] = t }
	else { npos++; posterm[npos] = t }
}

function parse_terms(s,   i, c, cur, inq, neg, seen) {
	npos = 0; nneg = 0
	cur = ""; inq = 0; neg = 0; seen = 0
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (c == "\"") { inq = !inq; seen = 1; continue }
		if (c == " " && !inq) {
			if (seen) add_term(cur, neg)
			cur = ""; neg = 0; seen = 0
			continue
		}
		# Only a minus at the head of a term negates it, so Block-Internet is
		# one term and not a negated Internet.
		if (!seen && c == "-") { neg = 1; seen = 1; continue }
		cur = cur c
		seen = 1
	}
	if (seen) add_term(cur, neg)
}

function hits(hay, t,   na, j, alt) {
	na = split(t, alt, ",")
	for (j = 1; j <= na; j++)
		if (alt[j] != "" && index(hay, alt[j]) > 0) return 1
	return 0
}

function jstr(s,   i, c, out) {
	out = ""
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (c == "\"" || c == "\\") out = out "\\" c
		else if (c ~ /[[:cntrl:]]/) out = out " "
		else out = out c
	}
	return out
}

function emit(s, k, sep,   nf) {
	nf = split(ring[s, k], _f, "\t")
	printf "%s{\"ts\":%d,\"id\":\"%s:%d\",\"verdict\":\"%s\",\"fam\":%d,\"proto\":\"%s\",", \
		sep, _f[1], s, _f[2], jstr(_f[4]), _f[5], jstr(_f[6])
	printf "\"saddr\":\"%s\",\"sport\":\"%s\",\"daddr\":\"%s\",\"dport\":\"%s\",", \
		jstr(_f[7]), jstr(_f[8]), jstr(_f[9]), jstr(_f[10])
	printf "\"iif\":\"%s\",\"oif\":\"%s\",\"dir\":\"%s\",\"rule\":\"%s\",\"extra\":\"%s\"}", \
		jstr(_f[11]), jstr(_f[12]), jstr(_f[13]), jstr(_f[14]), jstr(_f[15])
}

BEGIN {
	# Changing a field rebuilds the record, so the separator has to be the
	# one the record is written with.
	OFS = "\t"
	# How far apart a log line and a conntrack event may be and still be the
	# same packet, and how much of the accepted feed is worth indexing. The
	# follower holds a verdictless event about a second before writing it, so
	# by the time it is read here its conntrack event has long since landed.
	pair_window = 5
	pair_recent = 30
	lim = lim + 0
	if (lim < 1) lim = 200
	if (lim > 1000) lim = 1000
	after["log"] = alog + 0
	after["ct"] = act + 0
	parse_terms(tolower(q))
	nv = split(vfilter, _vf, ",")
	nwant = 0
	for (i = 1; i <= nv; i++)
		if (_vf[i] != "" && !(_vf[i] in want)) { want[_vf[i]] = 1; nwant++ }
	shed = statval(statlog, "shed") + statval(statct, "shed")
	trimmed = statval(statlog, "trimmed") + statval(statct, "trimmed")
}

NF < 15 { next }

{
	s = $3
	if (s != "log" && s != "ct") next

	# A packet that was allowed through leaves a conntrack entry behind and a
	# refused one does not, and fw4 accepts established traffic before any
	# rule runs, so everything that reaches a rule is a new connection. That
	# makes a matching conntrack event positive proof the packet was allowed,
	# which is the only thing that can put a verdict on a log line whose
	# prefix carried nothing but a rule name.
	#
	# Only the positive half is inferred. No conntrack event is not proof of a
	# refusal: the accepted feed may be off, or the event may have been
	# trimmed, so those stay unknown rather than being guessed at.
	ctkey = ""
	if (s == "ct") {
		if (now - $1 <= pair_recent) {
			k = $6 SUBSEP $7 SUBSEP $8 SUBSEP $9 SUBSEP $10
			if ($1 + 0 > ctts[k]) ctts[k] = $1 + 0
			ctkey = k
		}
	}
	else if ($4 == "unknown") {
		k = $6 SUBSEP $7 SUBSEP $8 SUBSEP $9 SUBSEP $10
		if (k in ctts) {
			d = ctts[k] - ($1 + 0)
			if (d < 0) d = -d
			if (d <= pair_window) {
				$4 = "accept"
				resolved++
				# The two are one connection, and the log event is the better
				# half of it: it carries the rule name and the bridge port,
				# which a conntrack event never has. So the conntrack row stops
				# being an event of its own, here and in the counts.
				#
				# Only once per tuple. A rule that logs every packet of a flow
				# produces several verdictless events against the single NEW
				# event that resolves them all.
				if (!(k in ctpaired)) {
					ctpaired[k] = 1
					counts["accept"]--
					# Not in the ring means filtered out, or delivered in an
					# earlier poll and already on the page. The first needs no
					# suppressing and the second cannot be suppressed: the row
					# is behind the cursor and this response cannot reach it.
					if (k in ctslot && rsq["ct", ctslot[k]] == ctsq[k]) {
						dead["ct", ctslot[k]] = 1
						deadct++
					}
				}
			}
		}
	}

	# the buffer wide figures, taken before any filter is applied
	if ($2 + 0 > seqmax[s]) seqmax[s] = $2 + 0
	buffered[s]++
	counts[$4]++
	if (oldest == 0 || $1 + 0 < oldest) oldest = $1 + 0

	if (after[s] > 0 && $2 + 0 <= after[s]) next
	if (nwant > 0 && !($4 in want)) next
	if (pfilter != "" && $6 != pfilter) next
	if (dfilter != "" && $13 != dfilter) next
	if (npos > 0 || nneg > 0) {
		hay = tolower($7 " " $8 " " $9 " " $10 " " $11 " " $12 " " $14 " " $15)
		for (ti = 1; ti <= npos; ti++) if (!hits(hay, posterm[ti])) next
		for (ti = 1; ti <= nneg; ti++) if (hits(hay, negterm[ti])) next
	}

	# Each spool is appended in time order and trimmed from the front, so the
	# newest lim matching lines are simply the last lim to arrive. That is why
	# there is no sort here: a ring per source, then one merge.
	i = n[s] % lim
	ring[s, i] = $0
	rts[s, i] = $1 + 0
	rsq[s, i] = $2 + 0
	dead[s, i] = 0
	n[s]++

	# Where this conntrack event landed, so a log event that pairs with it
	# later in this same pass can strike it out. The sequence number is kept
	# alongside because the ring wraps, and by then the slot may hold a
	# different event entirely.
	if (ctkey != "" && ctts[ctkey] == $1 + 0) {
		ctslot[ctkey] = i
		ctsq[ctkey] = $2 + 0
	}
}

END {
	avail["log"] = (n["log"] < lim) ? n["log"] : lim
	avail["ct"] = (n["ct"] < lim) ? n["ct"] : lim
	matched = n["log"] + n["ct"] - deadct

	printf "{\"now\":%d,", now
	printf "\"seq\":{\"log\":%d,\"ct\":%d},", seqmax["log"], seqmax["ct"]
	printf "\"counts\":{\"accept\":%d,\"drop\":%d,\"reject\":%d,\"unknown\":%d},", \
		counts["accept"], counts["drop"], counts["reject"], counts["unknown"]
	printf "\"buffered\":{\"log\":%d,\"ct\":%d},", buffered["log"], buffered["ct"]
	printf "\"oldest\":%d,\"dropped\":%d,\"trimmed\":%d,\"resolved\":%d,", \
		oldest, shed, trimmed, resolved
	printf "\"matched\":%d,\"truncated\":%s,", matched, (matched > lim) ? "true" : "false"
	printf "\"events\":["

	ia = 0; ib = 0; out = 0; sep = ""
	while (out < lim && (ia < avail["log"] || ib < avail["ct"])) {
		ka = (n["log"] - 1 - ia) % lim
		kb = (n["ct"] - 1 - ib) % lim
		if (ia >= avail["log"]) pick = "ct"
		else if (ib >= avail["ct"]) pick = "log"
		else if (rts["log", ka] != rts["ct", kb])
			pick = (rts["log", ka] > rts["ct", kb]) ? "log" : "ct"
		else
			pick = (rsq["log", ka] >= rsq["ct", kb]) ? "log" : "ct"

		kp = (pick == "log") ? ka : kb
		if (pick == "log") ia++; else ib++

		# A conntrack row struck out above: its log half is the one row this
		# connection gets, so this slot is walked over without spending any of
		# the limit on it.
		if (dead[pick, kp]) continue

		emit(pick, kp, sep)
		sep = ","
		out++
	}

	printf "]}\n"
}
' $FILES /dev/null

exit 0
